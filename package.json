{
  "name": "dsh-session-manager",
  "version": "0.6.0",
  "description": "DSH 会话回收站：会话详情归档入口、回收站多选还原/彻底删除、活跃会话保护。 · Session trash & permanent delete for DeepSeek Harness.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "client.css",
    "cordis.patch.yml",
    "packages/session-trash-host/lib",
    "packages/session-trash-host/package.json"
  ],
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "session",
    "trash",
    "recycle-bin",
    "session-management"
  ],
  "repository": "https://github.com/sunshaobei/dsh-session-manager.git",
  "homepage": "https://github.com/sunshaobei/dsh-session-manager#readme",
  "bugs": {
    "url": "https://github.com/sunshaobei/dsh-session-manager/issues"
  },
  "dsh": {
    "displayName": "DSH 会话回收站",
    "description": "DSH 会话回收站：会话详情归档入口、回收站多选还原/彻底删除、活跃会话保护。",
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "homepage": "https://github.com/sunshaobei/dsh-session-manager",
    "repository": "https://github.com/sunshaobei/dsh-session-manager",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "prepublishOnly": "npm test",
    "verify:host": "node scripts/verify-real-host.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
